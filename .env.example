# ===== تنظیمات اصلی ربات =====

# توکن ربات از @BotFather
BOT_TOKEN=123456789:***

# آیدی عددی ادمین(های) اصلی (سوپرادمین)، با کاما جدا شوند
# آیدی عددی خودت را از @userinfobot بگیر
ADMIN_IDS=111111111,222222222

# ===== اطلاعات پرداخت کارت‌به‌کارت =====

CARD_NUMBER=6037-xxxx-xxxx-xxxx
CARD_OWNER=نام و نام خانوادگی صاحب کارت

# ===== تنظیمات تأیید خودکار سفارش/شارژ (دقیقه) =====

AUTO_APPROVE_MINUTES=30

# ===== آیدی پشتیبانی (اختیاری) =====

SUPPORT_USERNAME=@your_support_username

# ===== کانال عضویت اجباری (اختیاری - خالی = غیرفعال) =====
# ربات باید عضو (ترجیحاً ادمین) این کانال باشد

REQUIRED_CHANNEL=@your_channel_username

# ===== بک‌آپ خودکار دیتابیس (ساعت) =====

BACKUP_INTERVAL_HOURS=24

# ===== مسیر دیتابیس (اختیاری) =====
# مسیر نسبی نسبت به پوشه bot.py یا مسیر مطلق
DATABASE_FILE=bot.db

# اطلاعات هر پنل 3x-ui از داخل پنل ادمین ثبت می‌شود؛
# API Token را اینجا قرار نده.

# ===== شبکه Telegram (اختیاری) =====
# اگر api.telegram.org روی اینترنت مستقیم در دسترس نیست، Proxy را تنظیم کن.
# نمونه: TELEGRAM_PROXY=http://127.0.0.1:8080
# برای SOCKS به نصب aiohttp-socks نیاز است.
TELEGRAM_PROXY=

WEB_ADMIN_PASSWORD=یک_رمز_قوی_و_منحصربه‌فرد
WEB_ADMIN_SECRET=یک_کلید_تصادفی_طولانی
WEB_HOST=0.0.0.0
WEB_PORT=8090
WEB_ONLY=0
WEB_COOKIE_SECURE=0
WEB_WITH_BOT=1

